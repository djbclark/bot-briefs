#!/usr/bin/env python3
"""ref-append <BOT> [FILE|-]  -> appends ONE fresh "Ref: <BOT>-<x>" line to the end of a post and prints the finished text.

Reads FILE (or stdin if FILE is omitted or "-"). Uses /home/box/bin/ref, so the same global base-36 counter and lock.
Refuses (exit 2, nothing consumed) if the text is empty or its last non-blank line already is a Ref line, so a post
can only get one. With --in-place FILE, rewrites FILE with the result as well as printing it (atomic replace).
"""
import os, re, subprocess, sys, tempfile

REF_RE = re.compile(r"^\s*Ref:\s*[A-Z0-9]+-[0-9a-z]+\s*$")
USAGE = "usage: ref-append [--in-place] <BOT> [FILE|-]"

def main(argv):
    args = [a for a in argv[1:] if a != "--in-place"]
    in_place = "--in-place" in argv[1:]
    if not args or args[0].startswith("-") or len(args) > 2:
        sys.exit(USAGE)
    bot, src = args[0], (args[1] if len(args) > 1 else "-")
    if in_place and src == "-":
        sys.exit("--in-place needs a FILE")
    text = sys.stdin.read() if src == "-" else open(src, encoding="utf-8").read()
    lines = text.rstrip().splitlines()
    if not lines:
        sys.exit("ref-append: refusing, text is empty")
    if REF_RE.match(lines[-1]):
        sys.stderr.write("ref-append: refusing, text already ends with a Ref line: %s\n" % lines[-1].strip())
        sys.exit(2)
    r = subprocess.run([os.path.join(os.path.dirname(os.path.abspath(__file__)), "ref"), bot],
                       capture_output=True, text=True)
    ref = r.stdout.strip()
    if r.returncode != 0 or not REF_RE.match(ref):
        sys.exit("ref-append: ref failed: " + (r.stderr.strip() or ref))
    out = text.rstrip() + "\n\n" + ref + "\n"
    if in_place:
        d = os.path.dirname(os.path.abspath(src))
        fd, tmp = tempfile.mkstemp(dir=d)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(out)
        os.chmod(tmp, os.stat(src).st_mode & 0o7777)
        os.replace(tmp, src)
    sys.stdout.write(out)

main(sys.argv)
