#!/usr/bin/env bash
# tool-update: keep listed uv tools at the latest PyPI release; smoke-test; roll back on failure.
# Staging (L-6): a release must be at least TOOL_UPDATE_MIN_AGE_DAYS old (default 1, i.e. 24 hours) before it is installed,
# so a hijacked/yanked release has time to be caught. A list line "name==X.Y" pins that tool (never upgraded).
set -uo pipefail
LIST="$HOME/.config/repo-sync/uv-tools.txt"
MIN_AGE_DAYS=${TOOL_UPDATE_MIN_AGE_DAYS:-1}
while read -r t; do
  [ -z "$t" ] || [[ "$t" == \#* ]] && continue
  if [[ "$t" == *==* ]]; then echo "TOOL ${t%%==*}: PINNED ${t#*==}"; continue; fi
  inst=$(sed -nE 's/.*name = "'"$t"'", specifier = "==([^"]+)".*/\1/p' "$HOME/.local/share/uv/tools/$t/uv-receipt.toml" 2>/dev/null)
  [ -z "$inst" ] && inst=$("$HOME/.local/bin/$t" --version 2>/dev/null | awk '{print $NF}')
  latest=$(curl -sf "https://pypi.org/pypi/$t/json" | jq -r '.info.version') || { echo "TOOL $t: PYPI_FAILED"; continue; }
  if [ "$inst" = "$latest" ]; then echo "TOOL $t: UP_TO_DATE $inst"; continue; fi
  up=$(curl -sf "https://pypi.org/pypi/$t/$latest/json" | jq -r '[.urls[].upload_time_iso_8601] | min // empty' 2>/dev/null)
  if [ -n "$up" ] && up_s=$(date -d "$up" +%s 2>/dev/null); then
    age=$(( ($(date +%s) - up_s) / 86400 ))
    if [ "$age" -lt "$MIN_AGE_DAYS" ]; then echo "TOOL $t: HELD $inst -> $latest (released ${age}d ago, waiting ${MIN_AGE_DAYS}d)"; continue; fi
  fi
  if ! out=$(uv tool install --force "$t==$latest" 2>&1); then echo "TOOL $t: UPGRADE_FAILED $inst -> $latest: $(echo "$out" | tail -2 | tr '\n' ' ')"; continue; fi
  if v=$(timeout 60 "$HOME/.local/bin/$t" --version 2>&1) && [[ "$v" == *"$latest"* ]] && timeout 60 "$HOME/.local/bin/$t" --help >/dev/null 2>&1; then
    echo "TOOL $t: UPGRADED $inst -> $latest (smoke ok)"
  else
    uv tool install --force "$t==$inst" >/dev/null 2>&1
    echo "TOOL $t: UPGRADE_BROKE $inst -> $latest, ROLLED BACK to $inst: $(echo "$v" | tail -2 | tr '\n' ' ')"
  fi
done < "$LIST"
