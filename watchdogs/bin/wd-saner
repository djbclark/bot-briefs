#!/usr/bin/env bash
# Keeps the OpenCLI Browser Bridge (and so `opencli saner ...`) usable on the box (added 2026-10-28, Coding).
# Runs from monit every 10 cycles (~5 min). Exit 0 always.
#  1. Dedicated OpenCLI Chrome (profile WD_SANER_PROFILE on private Xvfb WD_SANER_DISPLAY, CDP WD_SANER_PORT) not running
#     -> start the private Xvfb if its display is gone (pid/log in $ST/saner-xvfb.*), then `box-chrome` with that
#     profile/port. Only that exact Chrome (matched by --user-data-dir) is checked or killed; other agents' Chromes are ignored.
#     2026-11-02: moved off platform-managed :13 (recycled with agent desktops) to private :300 + opencli-private profile
#     (copy of the old box-chrome profile). Rollback: cp wd-saner.bak-20261102 wd-saner (or WD_SANER_DISPLAY=:13 WD_SANER_PROFILE=<old-profile>).
#  2. Chrome up but extension not connected -> restart the opencli daemon once per episode.
#  3. Every WD_SANER_LOGIN_EVERY (1800 s): `opencli saner status`; if not logged in -> one hermes-ping (and one when it recovers).
#     Same cadence: `opencli shortwave status`; if not signed in -> one hermes-ping (state: shortwave.fail/.pinged), one on recovery.
#  4. Any problem lasting WD_SANER_NOTIFY_AFTER (1200 s) -> one hermes-ping; one more on recovery.
# Env: WD_SANER_NOTIFY=0 disables pings. Skips 04:58-05:10 ET. Never prints cookies or tokens.
export PATH=/home/box/.local/bin:/usr/local/bin:/usr/bin:/bin
export DISPLAY="${WD_SANER_DISPLAY:-:300}"
PROFILE="${WD_SANER_PROFILE:-/home/box/chrome-profile/opencli-private}"; PORT="${WD_SANER_PORT:-9335}"
ST=/home/box/.local/state/watchdogs; LOG=$ST/watchdog.log; F=$ST/saner.fail; ACT=$ST/saner.acted; PING=$ST/saner.pinged; LAST=$ST/saner.login-checked
mkdir -p "$ST"; log() { echo "$(date '+%F %T %Z') [saner] $*" >> "$LOG"; }
now=$(date +%s); hm=$(TZ=America/New_York date +%H%M)
{ [ "$hm" -ge 0458 ] && [ "$hm" -le 0510 ]; } && exit 0
notify() { [ "${WD_SANER_NOTIFY:-1}" != 0 ] && timeout 30 hermes-ping "$1" >/dev/null 2>&1; }
problem=""
chrome_pid() { ps -eo pid=,args= | awk -v w="--user-data-dir=$PROFILE" '$2 ~ /\/opt\/google\/chrome\/chrome$/ { t=0; u=0; for (i=3;i<=NF;i++) { if ($i ~ /^--type=/) t=1; if ($i == w) u=1 } if (u && !t) { print $1; exit } }'; }
chrome_on_display() { kill -0 "$1" 2>/dev/null && ps -eo args= | grep -F -- "DISPLAY=$DISPLAY " | grep -qF -- "--user-data-dir=$PROFILE "; }  # Chrome scrubs its own environ; box-chrome's box-bounded-log wrapper keeps DISPLAY= and the profile in argv for Chrome's lifetime
dn=${DISPLAY#:}; XP=$ST/saner-xvfb.pid; XA=$ST/saner-xvfb.Xauthority
case "$dn" in ''|*[!0-9]*) log "bad WD_SANER_DISPLAY '$DISPLAY' (want :N)"; exit 0 ;; esac
[ -r "$XA" ] && export XAUTHORITY="$XA"
umask 077
# refuse a display someone else pre-created
[ -e "/tmp/.X11-unix/X$dn" ] && [ "$(stat -c %u "/tmp/.X11-unix/X$dn")" != "$(id -u)" ] && { log "$DISPLAY socket not ours; refusing"; exit 0; }
if ! timeout 10 xdpyinfo -display "$DISPLAY" >/dev/null 2>&1; then
  if [ "$DISPLAY" = :300 ] || [ -n "${WD_SANER_OWN_XVFB:-}" ]; then
    xp=$(cat "$XP" 2>/dev/null); [ -n "$xp" ] && kill -0 "$xp" 2>/dev/null && tr '\0' ' ' < "/proc/$xp/cmdline" | grep -q "^Xvfb $DISPLAY " && kill "$xp" 2>/dev/null && sleep 1
    lp=$(tr -d ' ' 2>/dev/null < "/tmp/.X$dn-lock"); { [ -z "$lp" ] || ! kill -0 "$lp" 2>/dev/null; } && rm -f "/tmp/.X$dn-lock" "/tmp/.X11-unix/X$dn"
    # X access control ON: a private cookie in $XA (0600), so other local accounts can't drive this display
    ( umask 077; : > "$XA"; echo "add $DISPLAY . $(mcookie)" | xauth -f "$XA" source - >/dev/null 2>&1 )
    log "private display $DISPLAY missing; starting Xvfb"
    setsid nohup Xvfb "$DISPLAY" -screen 0 1920x1200x24 -auth "$XA" -nolisten tcp +extension GLX +render -noreset >"$ST/saner-xvfb.log" 2>&1 < /dev/null &
    echo $! > "$XP"; sleep 3
  else log "display $DISPLAY missing (not ours to start)"; fi
fi
cp_=$(chrome_pid)
if [ -n "$cp_" ] && ! chrome_on_display "$cp_"; then log "OpenCLI Chrome $cp_ not on $DISPLAY; stopping it"; kill "$cp_"; sleep 5; cp_=$(chrome_pid); fi
if [ -z "$cp_" ]; then
  log "OpenCLI Chrome ($PROFILE) not running; starting box-chrome on $DISPLAY port $PORT"
  [ -d "$PROFILE" ] && chmod 700 "$PROFILE"
  [ -r "$XA" ] && export XAUTHORITY="$XA"
  CHROME_USER_DATA_DIR="$PROFILE" SAND_CHROME_REMOTE_DEBUG_PORT="$PORT" setsid nohup box-chrome >"$ST/saner-chrome.log" 2>&1 < /dev/null &
  sleep 20
fi
ext=$(timeout 40 opencli doctor 2>/dev/null | python3 -c "import sys,json;print(json.load(sys.stdin)['data'].get('extensionConnected'))" 2>/dev/null)
if [ "$ext" != True ]; then
  problem="${problem:+$problem; }extension not connected"
  if [ ! -f "$ACT" ]; then : > "$ACT"; log "extension not connected: restarting opencli daemon"; timeout 30 opencli daemon restart >/dev/null 2>&1; fi
elif [ ! -f "$LAST" ] || [ $(( now - $(stat -c %Y "$LAST") )) -ge "${WD_SANER_LOGIN_EVERY:-1800}" ]; then
  : > "$LAST"
  s=$(timeout 40 opencli saner status 2>&1 | python3 -c "import sys,json;print(json.load(sys.stdin)['data'][0].get('login'))" 2>/dev/null)
  [ "$s" = yes ] || problem="Saner not signed in (needs a sign-in on the box Chrome)"
  sw=$(timeout 40 opencli shortwave status 2>&1 | python3 -c "import sys,json;print(json.load(sys.stdin)['data'][0].get('login'))" 2>/dev/null)
  SWF=$ST/shortwave.fail; SWP=$ST/shortwave.pinged
  if [ "$sw" = no ]; then
    [ -f "$SWF" ] || { echo "$now" > "$SWF"; log "problem: Shortwave not signed in"; }
    [ -f "$SWP" ] || { : > "$SWP"; log "notifying: Shortwave not signed in"; notify "Shortwave on the box Chrome is not signed in (opencli shortwave needs a sign-in at app.shortwave.com)"; }
  elif [ "$sw" = yes ] && [ -f "$SWF" ]; then
    log "shortwave recovered"; [ -f "$SWP" ] && notify "Shortwave on the box is signed in again"; rm -f "$SWF" "$SWP"
  elif [ "$sw" != yes ]; then log "shortwave status check failed (not a login verdict)"; fi
fi
if [ -z "$problem" ]; then
  if [ -f "$F" ]; then d=$(( now - $(cat "$F") )); log "recovered after ${d}s"; [ -f "$PING" ] && notify "Saner/OpenCLI on the box is working again after $((d/60)) min"; rm -f "$F" "$ACT" "$PING"; fi
  exit 0
fi
[ -f "$F" ] || { echo "$now" > "$F"; log "problem: $problem"; }
age=$(( now - $(cat "$F") ))
case "$problem" in *"not signed in"*) lim=0;; *) lim=${WD_SANER_NOTIFY_AFTER:-1200};; esac
if [ "$age" -ge "$lim" ] && [ ! -f "$PING" ]; then : > "$PING"; log "notifying: $problem"; notify "Saner/OpenCLI on the box: $problem (for $((age/60)) min)"; fi
exit 0
