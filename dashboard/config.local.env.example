# Copy to config.local.env (gitignored, chmod 600). Loaded at startup; real env vars win.
# Prefer runtime TOML on VPS: see config.example.toml and docs/nix-deployment.md (BRIEFS_CONFIG_FILE).
BRIEFS_ALLOWED_LOGINS=<USER_EMAIL>
# BRIEFS_ALLOWED_HOSTS=localhost,127.0.0.1,<box>.<tailnet>.ts.net
# BRIEFS_BOT_IDS=cos=<uuid>,radar=<uuid>
