# KEY=VALUE lines read by notify-bot (environment values win). Mode 600. Never commit, never paste in chat.
# Create each by adding a WEBHOOK routine to the bot (Grok Bot UpdateRoutine, webhook trigger); copy its URL and key here.
#AGENT_WEBHOOK_CHIEF_OF_STAFF_URL=<YOUR_COS_WEBHOOK_URL>
#AGENT_WEBHOOK_CHIEF_OF_STAFF_KEY=<YOUR_COS_WEBHOOK_KEY>
#AGENT_WEBHOOK_CODING_URL=<YOUR_CODING_WEBHOOK_URL>
#AGENT_WEBHOOK_CODING_KEY=<YOUR_CODING_WEBHOOK_KEY>
# Box-wide secrets used elsewhere (store as Grok Bot box env secrets, NOT in this file):
